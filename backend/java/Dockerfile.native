# Stage 1: Build using Oracle's official GraalVM image
# This image contains GraalVM for Java 21.
FROM container-registry.oracle.com/graalvm/native-image:21 AS builder

WORKDIR /app

# Install Maven
RUN microdnf install -y maven

# Copy the application source code
COPY . .

# Build the native executable for Linux
RUN mvn package -Pnative -DskipTests

# Stage 2: Create a more complete runtime image
FROM ubuntu:22.04

WORKDIR /app

# Create a non-root user
RUN groupadd --system appuser && \
    useradd --system --gid appuser appuser && \
    chown -R appuser:appuser /app

# Copy the native executable from the builder stage
COPY --from=builder --chown=appuser:appuser /app/target/beauty-salon /app/beauty-salon

# Switch to the non-root user
USER appuser

# Expose the port the application will run on
EXPOSE 8081

# Run the native executable
ENTRYPOINT ["/app/beauty-salon"]

# Dockerfile for GraalVM Native Image - Google Distroless
# Ultra-minimal, secure base image without shell
# Similar to Go's scratch but with minimal C library

FROM gcr.io/distroless/base-debian12:nonroot

# Set working directory
WORKDIR /app

# Copy the pre-built native executable
COPY --chown=nonroot:nonroot target/beauty-salon-reactive ./beauty-salon-reactive

# Expose port
EXPOSE 8085

# Run as non-root user (already set by base image)
USER nonroot:nonroot

# Run the native executable
ENTRYPOINT ["./beauty-salon-reactive"]
CMD ["--server.port=8085", "--spring.profiles.active=docker"]

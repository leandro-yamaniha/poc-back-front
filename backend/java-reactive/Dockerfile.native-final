# Dockerfile for GraalVM Native Image - Working Version
# Builds and runs native executable in Linux environment

FROM ghcr.io/graalvm/native-image-community:21 AS builder

# Install Maven
RUN microdnf install -y maven

# Set working directory
WORKDIR /app

# Copy Maven wrapper and pom.xml
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./

# Download dependencies
RUN ./mvnw dependency:go-offline -B

# Copy source code
COPY src/ src/

# Build native executable with AOT
RUN ./mvnw clean compile spring-boot:process-aot -Pnative -DskipTests
RUN ./mvnw native:compile -Pnative -DskipTests

# Runtime image with Ubuntu (more compatible)
FROM ubuntu:22.04

# Install runtime libraries
RUN apt-get update && \
    apt-get install -y \
        ca-certificates \
        libstdc++6 \
        zlib1g \
        && rm -rf /var/lib/apt/lists/* && \
        groupadd -r appuser && useradd -r -g appuser appuser

# Set working directory
WORKDIR /app

# Copy native executable from builder
COPY --from=builder /app/target/beauty-salon-reactive ./beauty-salon-reactive

# Set permissions
RUN chmod +x ./beauty-salon-reactive && \
    chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8085

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8085/actuator/health || exit 1

# Run the application
ENTRYPOINT ["./beauty-salon-reactive"]
CMD ["--server.port=8085", "--spring.profiles.active=docker"]
